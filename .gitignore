# Secrets and credentials - never commit these.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
*_rsa
*_ed25519

# Tokens of any kind.
*.token
*.tokens
tokens.json
gh_token.txt
github_token.txt

# Caches and build output.
__pycache__/
*.py[cod]
.godot/
.import/
.cache/
node_modules/
*.log

# Scratch and editor files.
scratch/
scratch*
tmp/
tmp*
*.tmp
*.bak
*.orig
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.vscode/
.idea/

# Godot export output.
build/
export/
*.pck
*.zip
*.exe
